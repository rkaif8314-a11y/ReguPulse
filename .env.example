# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin / Firestore (server-only; never prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Razorpay recurring subscriptions (INR)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PLAN_STARTER=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_GROWTH=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_AGENCY=plan_xxxxxxxxxxxxxx

# Scheduled monitoring
CRON_SECRET=generate-a-strong-random-secret
