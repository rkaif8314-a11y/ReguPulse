NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase server-side storage. Never expose the service role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GUEST_HASH_SECRET=replace-with-a-long-random-secret

# Razorpay recurring subscriptions. Create matching monthly plans in the Razorpay Dashboard.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PLAN_STARTER=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_GROWTH=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_AGENCY=plan_xxxxxxxxxxxxxx

# Razorpay plan amounts must match: Starter INR 199/month, Growth INR 499/month, Agency INR 1499/month.